# Experimental data. Far too large for git: the pva image stacks run to 110 MB
# each, over GitHub's hard 100 MB-per-file limit, and the directory holds
# ~558 MB in all. The viewers read these from disk; they are not part of the
# code and are not ours to publish.
*.h5
*.hdf
*.hdf5

# Generated by plot_last_scan.py
last_scan.png

# Python bytecode
__pycache__/
*.py[cod]

# Local tooling and machine-specific state
.claude/
logs/

# macOS
.DS_Store
